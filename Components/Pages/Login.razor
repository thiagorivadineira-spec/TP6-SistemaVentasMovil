@page "/login"
@inject ApiClient Api
@inject AppAuthStateProvider Auth
@inject NavigationManager Nav

<PageTitle>Iniciar sesión</PageTitle>

<h1>Iniciar sesión</h1>

<div class="card">
    @if (_error != null)
    {
        <div class="aviso aviso-error">@_error</div>
    }

    <label>Usuario</label>
    <input type="text" autocapitalize="none" autocomplete="username" @bind="_usuario" />

    <label>Contraseña</label>
    <input type="password" autocomplete="current-password" @bind="_password" />

    <button class="btn btn-bloque" disabled="@_cargando" @onclick="Ingresar">
        @(_cargando ? "Ingresando..." : "Ingresar")
    </button>
    <a class="btn btn-sec btn-bloque" href="registro">Crear cuenta de cliente</a>
</div>

@code {
    [SupplyParameterFromQuery(Name = "volver")] public string? Volver { get; set; }

    private string _usuario = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _cargando;

    protected override async Task OnInitializedAsync()
    {
        var estado = await Auth.GetAuthenticationStateAsync();
        if (estado.User.Identity?.IsAuthenticated == true) Nav.NavigateTo("", replace: true);
    }

    private async Task Ingresar()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_usuario) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Ingresá usuario y contraseña.";
            return;
        }

        _cargando = true;
        var r = await Api.LoginAsync(_usuario.Trim(), _password);
        _cargando = false;

        if (!r.Ok || r.Datos == null)
        {
            _error = r.Error ?? "No se pudo iniciar sesión.";
            return;
        }

        await Auth.IniciarSesionAsync(new SesionUsuario
        {
            Token = r.Datos.Token,
            Expira = r.Datos.Expira,
            Id = r.Datos.Id,
            Nombre = r.Datos.Nombre,
            Username = r.Datos.Username,
            Rol = r.Datos.Rol,
            ClienteId = r.Datos.ClienteId
        });

        // Solo se aceptan rutas internas, para que nadie pueda mandar al usuario a otro sitio
        var destino = !string.IsNullOrEmpty(Volver) && Volver.StartsWith('/') && !Volver.StartsWith("//") && !Volver.Contains(':')
            ? Volver.TrimStart('/')
            : string.Empty;

        Nav.NavigateTo(destino);
    }
}
