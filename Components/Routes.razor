<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(MauiProgram).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated == true)
                    {
                        <div class="aviso aviso-error">
                            <strong>Sin permiso.</strong> Tu rol no permite entrar a esta pantalla.
                        </div>
                        <a class="btn" href="">Volver al catálogo</a>
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
                <Authorizing>
                    <p class="cargando">Verificando sesión...</p>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <div class="aviso aviso-error">Esta pantalla no existe.</div>
                <a class="btn" href="">Ir al catálogo</a>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
